# Dùng Git LFS cho dữ liệu lớn
*.zip filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
data/fallalld_demo_synthetic.csv -filter -diff -merge text
# Explicitly keep the small demo artifacts as ordinary Git blobs; a parent-level
# repository LFS policy also matches images and joblib models.
docs/slides_preview/*.png -filter -diff -merge text
models/*.joblib -filter -diff -merge text
*.parquet filter=lfs diff=lfs merge=lfs -text
